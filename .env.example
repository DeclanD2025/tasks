# ORION environment configuration (example).
# Copy to `.env` and adjust. Never commit a real `.env`.
# ORION is local-first: none of these are required to launch the demo app.

# --- App ---
ORION_ENV=development          # development | production
ORION_LOG_LEVEL=INFO

# --- Database ---
# Leave blank to use the default local SQLite file in the OS app-data dir.
# For the future PostgreSQL option:
#   ORION_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/orion
ORION_DATABASE_URL=

# Legacy Mac-to-Mac iCloud Drive database sync. Prefer CloudKit record sync for
# iPhone/iPad companion data; never sync the raw SQLite file to mobile.
ORION_ICLOUD_SYNC=0

# Optional path to a signed Swift helper that can push ORION's CloudKit outbox.
# If unset in development, scripts fall back to `swift run` under mobile/OrionSyncKit.
ORION_SYNC_HELPER=

# --- Security ---
# Optional passphrase for the local unlock screen. If unset, the unlock
# screen accepts the default demo passphrase (see README) in development.
# TODO(security): derive a key from this via a real KDF (argon2/scrypt) and
# use it to encrypt the SQLite file (e.g. SQLCipher) before storing real data.
ORION_UNLOCK_PASSPHRASE=

# --- Integration tokens (placeholders — NOT used yet) ---
# These connectors are scaffolded only. Prefer OS keychain storage for real
# secrets once credential entry is implemented.
# NEVER store bank login credentials. Open Banking uses OAuth/consent flows.
# TODO(security): move these to the OS keychain (keyring) instead of .env.
OPEN_BANKING_PROVIDER=
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
TRADING212_API_KEY=
TRADING212_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
MONEYBOX_TOKEN=
NOTION_TOKEN=
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# --- Web access (app.web) ----------------------------------------------------
# Host/port for `uv run orion-web`. Default binds to this Mac only; set the
# host to 0.0.0.0 (or use ~/start-orion-web.command) to reach it from a phone
# on the same network. Never expose this server to the public internet.
ORION_WEB_HOST=127.0.0.1
ORION_WEB_PORT=8321
# Deployment extras (see docs/DEPLOY.md): session secret for containers and
# HTTPS-only cookie mode when served behind TLS.
ORION_WEB_SECRET=
ORION_WEB_SECURE=0

# --- Web v2 additions ---------------------------------------------------
# Enables POST /api/ingest/hae so the Health Auto Export iOS app can push
# exports directly to a deployed ORION (long random string; also set it as
# the Bearer token in the HAE REST automation).
# ORION_INGEST_TOKEN=

# Test/CI guard: skip all external signal fetches (weather/air/holidays/FX)
# and serve cache-or-quiet instead. Set automatically by the test suite.
# ORION_SIGNALS_OFFLINE=1
